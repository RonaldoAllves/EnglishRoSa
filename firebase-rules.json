{
  "rules": {
    "profiles": {
      "$profileId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'totalPoints', 'totalWords', 'totalCorrect', 'totalWrong', 'episodes', 'createdAt'])",
        "name": {
          ".validate": "newData.isString()"
        },
        "totalPoints": {
          ".validate": "newData.isNumber()"
        },
        "totalWords": {
          ".validate": "newData.isNumber()"
        },
        "totalCorrect": {
          ".validate": "newData.isNumber()"
        },
        "totalWrong": {
          ".validate": "newData.isNumber()"
        },
        "episodes": {
          "$episodeId": {
            ".validate": "newData.hasChildren(['episodeId', 'completed', 'totalQuestions', 'correctAnswers', 'wrongAnswers', 'points', 'bestStreak', 'attempts', 'categories'])"
          }
        }
      }
    },
    "episodios": {
      ".read": true,
      ".write": false
    }
  }
}
